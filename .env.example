# Muse Relay v2 — copy to .env and fill in. Never commit .env.

# Token the agent presents to the gateway. Long random string.
# (The hands still use their own per-session generated secret; this gates
# the gateway API only.)
RELAY_GATEWAY_TOKEN=

# Where the gateway reaches the Windows hands (host-native process).
# Default works with Docker Desktop / host-gateway on Linux.
HANDS_URL=http://host.docker.internal:5000
